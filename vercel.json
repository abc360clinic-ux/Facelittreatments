{
  "buildCommand": "node scripts/inject-gtm.js",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    {
      "source": "/medifacials/thank-you",
      "destination": "/thank-you/",
      "permanent": false
    },
    {
      "source": "/medifacials/thank-you/",
      "destination": "/thank-you/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(favicon.ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
